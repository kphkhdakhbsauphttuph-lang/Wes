local isDropdownOpen = false

local function RefreshPlayerDropdown()
    for _, child in pairs(ListHolder:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local count = 0
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local pBtn = Instance.new("TextButton")
            pBtn.Parent = ListHolder
            pBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            pBtn.BorderSizePixel = 0
            pBtn.Size = UDim2.new(1, 0, 0, 25)
            pBtn.Font = Enum.Font.SourceSans
            pBtn.Text = "👤 " .. plr.DisplayName
            pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            pBtn.TextSize = 12
            
            local pCorner = Instance.new("UICorner", pBtn)
            pCorner.CornerRadius = UDim.new(0, 4)
            
            pBtn.MouseButton1Click:Connect(function()
                Config.SelectedTargetPlayer = plr
                DropdownBtn.Text = "👤 เลือกอยู่: " .. plr.DisplayName
                isDropdownOpen = false
                DropdownFrame.Size = UDim2.new(1, 0, 0, 28)
            end)
        end
    end
    ListHolder.Size = UDim2.new(1, 0, 0, count * 27)
end

DropdownBtn.MouseButton1Click:Connect(function()
    isDropdownOpen = not isDropdownOpen
    if isDropdownOpen then
        RefreshPlayerDropdown()
        local totalHeight = 30 + ListHolder.Size.Y.Offset
        DropdownFrame.Size = UDim2.new(1, 0, 0, totalHeight)
    else
        DropdownFrame.Size = UDim2.new(1, 0, 0, 28)
    end
end)

